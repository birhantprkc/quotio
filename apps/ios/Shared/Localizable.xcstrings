    "Removing a host deletes its saved credential on this iPhone. Revoke the device on the computer to end its access everywhere.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a host deletes its saved credential on this iPhone. Revoke the device on the computer to end its access everywhere."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa máy sẽ xóa quyền truy cập đã lưu trên iPhone này. Thu hồi thiết bị trên máy tính để chấm dứt quyền truy cập hoàn toàn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un hôte efface son identifiant sur cet iPhone. Révoquez l’appareil sur l’ordinateur pour supprimer tout accès."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除主机会删除此 iPhone 上的凭据。请在电脑上撤销该设备以完全终止访问。"
          }
        }
      }
    },

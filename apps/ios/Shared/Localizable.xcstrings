    "Use an HTTPS address without a path, query or password.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an HTTPS address without a path, query or password."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",

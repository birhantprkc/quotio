    "Provider credentials stay on your Mac. This iPhone reads quota over HTTPS with read-only access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Provider credentials stay on your Mac. This iPhone reads quota over HTTPS with read-only access."}},"vi":{"stringUnit":{"state":"translated","value":"Thông tin đăng nhập nhà cung cấp nằm trên Mac. iPhone này chỉ đọc hạn mức qua HTTPS."}},"fr":{"stringUnit":{"state":"translated","value":"Les identifiants des fournisseurs restent sur votre Mac. Cet iPhone lit les quotas en HTTPS, en lecture seule."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务商凭据保留在 Mac 上。此 iPhone 仅通过 HTTPS 只读获取配额。"}}}},
    "Provider order": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Provider order"}},"vi":{"stringUnit":{"state":"translated","value":"Thứ tự nhà cung cấp"}},"fr":{"stringUnit":{"state":"translated","value":"Ordre des fournisseurs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务商顺序"}}}},
    "Provider returned no quota": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Provider returned no quota"}},"vi":{"stringUnit":{"state":"translated","value":"Nhà cung cấp không trả về hạn mức"}},"fr":{"stringUnit":{"state":"translated","value":"Le fournisseur n’a renvoyé aucun quota"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务商未返回配额"}}}},

    "Use a read-only device token issued by Quotio on your computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a read-only device token issued by Quotio on your computer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng token thiết bị chỉ đọc do Quotio trên máy tính cấp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

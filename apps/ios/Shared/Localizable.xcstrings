    "Touch and hold your Home Screen, choose Edit, then Add Widget and find Quotio. For the Lock Screen, touch and hold it, choose Customize, then Add Widgets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Home Screen, choose Edit, then Add Widget and find Quotio. For the Lock Screen, touch and hold it, choose Customize, then Add Widgets."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm giữ Màn hình chính, chọn Sửa, rồi Thêm widget và tìm Quotio. Với Màn hình khóa, chạm giữ, chọn Tùy chỉnh, rồi Thêm widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez l’écran d’accueil, choisissez Modifier puis Ajouter un widget et cherchez Quotio. Sur l’écran verrouillé, maintenez puis choisissez Personnaliser et Ajouter des widgets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主屏幕，选择编辑、添加小组件，然后查找 Quotio。在锁定屏幕上长按，选择自定义、添加小组件。"
          }
        }
      }
    },

    "Quotio on your Mac is busy or its credential storage is locked.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quotio on your Mac is busy or its credential storage is locked."}},"vi":{"stringUnit":{"state":"translated","value":"Quotio trên Mac đang bận hoặc kho thông tin đăng nhập đang khóa."}},"fr":{"stringUnit":{"state":"translated","value":"Quotio sur votre Mac est occupé ou son stockage d’identifiants est verrouillé."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Mac 上的 Quotio 正忙或凭据存储已锁定。"}}}},
